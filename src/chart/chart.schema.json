{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vibe-guitar.local/chart.schema.json",
  "title": "Vibe Guitar chord chart v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recording", "timing", "events", "coverage", "provenance"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "id", "title", "artist"],
      "properties": {
        "source": { "enum": ["youtube", "ytmusic", "applemusic"] },
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "artist": { "type": "string" }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bpm", "beatsPerBar", "firstDownbeatSec"],
      "properties": {
        "bpm": { "type": "number", "exclusiveMinimum": 0, "maximum": 400 },
        "beatsPerBar": { "type": "integer", "minimum": 1, "maximum": 16 },
        "beatUnit": { "enum": [4, 8] },
        "firstDownbeatSec": { "type": "number", "minimum": 0 },
        "beatTimes": {
          "type": "array",
          "items": { "type": "number", "minimum": 0 }
        },
        "feel": { "enum": ["straight", "shuffle"] }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["startSec", "chord", "confidence", "source"],
        "properties": {
          "startSec": { "type": "number", "minimum": 0 },
          "chord": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "source": { "enum": ["manual", "auto"] },
          "auto": {
            "type": "object",
            "description": "Manual events only: the first recognized chord this event replaced (restored by 처음 코드로 되돌리기).",
            "additionalProperties": false,
            "required": ["chord", "confidence"],
            "properties": {
              "chord": { "type": "string", "minLength": 1 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "span": {
                "type": "object",
                "description": "The uncertain span 2순위로 바꾸기 consumed (the event was split at its bounds).",
                "additionalProperties": false,
                "required": ["fromSec", "toSec", "chord", "alt"],
                "properties": {
                  "fromSec": { "type": "number", "minimum": 0 },
                  "toSec": { "type": "number", "minimum": 0 },
                  "chord": { "type": "string", "minLength": 1 },
                  "alt": { "type": "string", "minLength": 1 },
                  "replace": { "const": true }
                }
              },
              "split": {
                "type": "object",
                "description": "What that split created: the original event's start and whether a leading (head) and a trailing (tail) auto fragment were made.",
                "additionalProperties": false,
                "required": ["startSec", "head", "tail"],
                "properties": {
                  "startSec": { "type": "number", "minimum": 0 },
                  "head": { "type": "boolean" },
                  "tail": { "type": "boolean" }
                }
              }
            },
            "dependencies": { "span": ["split"], "split": ["span"] }
          }
        },
        "if": { "properties": { "source": { "const": "auto" } } },
        "then": { "not": { "required": ["auto"] } }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fromSec", "toSec"],
        "properties": {
          "fromSec": { "type": "number", "minimum": 0 },
          "toSec": { "type": "number", "minimum": 0 }
        }
      }
    },
    "uncertain": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fromSec", "toSec", "chord", "alt"],
        "properties": {
          "fromSec": { "type": "number", "minimum": 0 },
          "toSec": { "type": "number", "minimum": 0 },
          "chord": { "type": "string", "minLength": 1 },
          "alt": { "type": "string", "minLength": 1 },
          "replace": { "const": true, "description": "Replace tier: the second choice is offered as a one-tap replacement (absent = information only)." }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createdBy", "createdAt"],
      "properties": {
        "createdBy": { "enum": ["manual", "recognizer", "edited"] },
        "createdAt": { "type": "string", "minLength": 1 },
        "updatedAt": { "type": "string" },
        "tool": { "type": "string" },
        "note": { "type": "string" },
        "example": { "type": "boolean" }
      }
    }
  }
}
