{
  "name": "vibe-guitar",
  "version": "0.0.1",
  "private": true,
  "description": "Personal-use Chrome MV3 extension: time-synced guitar chords and level-based arrangements (phase 0 prototype).",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "fetch-models": "node scripts/fetch-models.mjs",
    "bench": "node scripts/bench.mjs",
    "accuracy-report": "node scripts/accuracy-report.mjs",
    "eval-annotations": "node scripts/eval-annotations.mjs",
    "heldout-songs": "node scripts/heldout-songs.mjs",
    "phone": "node scripts/phone.mjs",
    "phone-check": "node scripts/phone-check.mjs",
    "phone-layout": "node scripts/phone-layout.mjs",
    "build:latency-probe": "node scripts/build.mjs --latency-probe",
    "build:audio-dump": "node scripts/build.mjs --audio-dump",
    "latency-probe": "node scripts/latency-probe.mjs",
    "latency-report": "node scripts/latency-report.mjs",
    "audio-dump-receiver": "node scripts/audio-dump-receiver.mjs",
    "replay-audio": "node scripts/replay-audio.mjs",
    "replay-parity": "node scripts/replay-parity.mjs",
    "paired-eval": "node scripts/paired-eval.mjs",
    "baseline-analysis": "node scripts/baseline-analysis.mjs",
    "candidate-step": "node scripts/candidate-step.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "onnxruntime-node": "^1.31.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "onnxruntime-web": "^1.31.1"
  }
}
